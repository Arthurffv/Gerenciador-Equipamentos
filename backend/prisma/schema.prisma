generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Enums ─────────────

enum Setor {
  CAMPO
  LABORATORIO
  VIDRARIAS
}

enum Qualificacao {
  CRITICO
  NAO_CRITICO
}

enum StatusEquipamento {
  USO
  FORA_DE_USO
  MANUTENCAO
  OBSOLETO
}

enum ResultadoCalibracao {
  APROVADA
  APROVADA_COM_RESTRICAO
  REPROVADA
}

enum TipoManutencao {
  PREVENTIVA
  CORRETIVA
}

// ───────────── Equipamento (aba "PLANILHA GERAL") ─────────────

model Equipamento {
  id               String            @id @default(uuid())
  setor            Setor
  codigo           String // ex.: AQAN 003 (único dentro do setor)
  nome             String // coluna "Equipamento" (tipo: Anemômetro, Autoclave...)
  amostrador       String? // coluna "Amostrador"
  numeroSerie      String?           @map("numero_serie")
  modelo           String?
  fabricante       String?
  qualificacao     Qualificacao
  status           StatusEquipamento @default(USO)
  localizacaoAtual String?           @map("localizacao_atual")
  observacoes      String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  calibracoes      Calibracao[]
  manutencoes      Manutencao[]
  analisesCriticas AnaliseCritica[]

  @@unique([setor, codigo])
  @@index([setor, status])
  @@map("equipamentos")
}

// ───────────── Histórico ─────────────

// Aba "PLANILHA CALIBRAÇÃO"
model Calibracao {
  id            String      @id @default(uuid())
  equipamentoId String      @map("equipamento_id")
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

  numeroCertificado String?   @map("numero_certificado")
  escala            String?
  faixaCalibracao   String?   @map("faixa_calibracao")
  dataCalibracao    DateTime? @map("data_calibracao") @db.Date
  intervaloMeses    Int?      @map("intervalo_meses")
  proximaCalibracao DateTime? @map("proxima_calibracao") @db.Date
  erroMaximo        String?   @map("erro_maximo")
  normasReferencia  String?   @map("normas_referencia")
  laboratorio       String?
  resultado         ResultadoCalibracao?
  observacoes       String?

  // Certificado no MinIO: guarde a CHAVE do objeto e gere URL assinada sob demanda.
  certificadoKey  String? @map("certificado_key")
  certificadoNome String? @map("certificado_nome")
  certificadoUrl  String? @map("certificado_url")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([equipamentoId, dataCalibracao(sort: Desc)])
  @@index([proximaCalibracao])
  @@map("calibracoes")
}

// Aba "PLANILHA DE MANUTENÇÃO"
model Manutencao {
  id            String      @id @default(uuid())
  equipamentoId String      @map("equipamento_id")
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

  tipo               TipoManutencao @default(PREVENTIVA)
  dataManutencao     DateTime?      @map("data_manutencao") @db.Date
  periodicidadeMeses Int?           @map("periodicidade_meses")
  proximaManutencao  DateTime?      @map("proxima_manutencao") @db.Date
  responsavel        String?
  descricao          String?
  custo              Decimal?       @db.Decimal(12, 2)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([equipamentoId, dataManutencao(sort: Desc)])
  @@index([proximaManutencao])
  @@map("manutencoes")
}

model AnaliseCritica {
  id            String      @id @default(uuid())
  equipamentoId String      @map("equipamento_id")
  equipamento   Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)

  dataAnalise    DateTime @map("data_analise") @db.Date
  analista       String
  parecer        String
  conforme       Boolean  @default(true)
  acaoNecessaria String?  @map("acao_necessaria")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([equipamentoId, dataAnalise(sort: Desc)])
  @@map("analises_criticas")
}
