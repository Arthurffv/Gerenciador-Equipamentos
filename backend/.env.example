DATABASE_URL="postgresql://eqp_user:eqp_pass@localhost:5432/equipamentos?schema=public"

#API
PORT=3001 

#MinIO (mesmos valores do .env da raiz)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=certificados

#Login: troque por uma frase longa e aleatória (assina as sessões). Obrigatório em produção.
JWT_SECRET=IHaveNoPlans
#Horas até a sessão expirar
SESSAO_HORAS=8
# Endereço do frontend (vários: separe por vírgula)
FRONTEND_URL=http://localhost:5173
# Fuso horário da empresa: define quando "vira o dia" no cálculo de vencimentos (mesmo que o servidor esteja em UTC)
FUSO_HORARIO=America/Sao_Paulo