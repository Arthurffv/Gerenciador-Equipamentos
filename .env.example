# --- PostgreSQL ---
POSTGRES_USER=eqp_user
POSTGRES_PASSWORD=eqp_pass
POSTGRES_DB=equipamentos
# Porta no SEU computador. Se a 5432 já estiver ocupada, use outra (ex.: 5544)
# e use a mesma porta no DATABASE_URL de backend/.env
POSTGRES_PORT=5432

