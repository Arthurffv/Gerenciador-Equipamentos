# --- PostgreSQL ---
POSTGRES_USER=eqp_user
POSTGRES_PASSWORD=eqp_pass
POSTGRES_DB=equipamentos

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=certificados

# --- Backend (backend/.env) ---
DATABASE_URL="postgresql://eqp_user:eqp_pass@localhost:5432/equipamentos?schema=public"
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
